root = true

[*.cs]
# --- 基本フォーマット (これらは維持) ---
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = false

# --- 命名規則をすべて「none」にしてオフにする ---
dotnet_naming_rule.types_and_methods_should_be_pascalcase.severity = none
dotnet_naming_rule.locals_should_be_camelcase.severity = none
dotnet_naming_rule.fields_should_be_camelcase.severity = none
dotnet_naming_rule.const_fields_should_be_all_upper.severity = none
dotnet_naming_rule.enum_members_should_be_pascalcase.severity = none

# 命名規則違反の診断（IDE1006）自体をオフにする
dotnet_diagnostic.IDE1006.severity = none

# --- 修飾子の設定 (サイレントに維持) ---
dotnet_style_require_accessibility_modifiers = always:silent

# --- ReSharperの命名・名前空間チェックを完全に黙らせる ---
# 名前空間の場所チェックをオフ
resharper_namespace_does_not_correspond_to_file_location_highlighting = none
resharper_check_namespace_highlighting = none

# 命名規則（名前の付け方）のチェックをオフ
resharper_inconsistent_naming_highlighting = none

