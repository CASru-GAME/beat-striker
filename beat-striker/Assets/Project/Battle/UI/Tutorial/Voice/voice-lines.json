{
  "Credit": "VOICEVOX:ずんだもん",
  "Speaker": 3,
  "Clips": [
    {
      "Id": "overview",
      "Text": "チュートリアルを始めるのだ！"
    },
    {
      "Id": "next",
      "Text": "で次へ。"
    },
    {
      "Id": "walk_intro",
      "Text": "まずは歩いて、間合いをつかむのだ！"
    },
    {
      "Id": "walk_end",
      "Text": "歩いてみよう。"
    },
    {
      "Id": "rhythm_three",
      "Text": "のどれかを、リズムに合わせて三拍連続で成功させるのだ。"
    },
    {
      "Id": "rhythm_retry",
      "Text": "ミスや押し忘れで、最初からやり直しだ。"
    },
    {
      "Id": "rhythm_press",
      "Text": "リズムに合わせて、"
    },
    {
      "Id": "dash_end",
      "Text": "を押すとダッシュができるのだ。"
    },
    {
      "Id": "dash_practice",
      "Text": "を押して、ダッシュしてみよう。"
    },
    {
      "Id": "attack_end",
      "Text": "を押すと攻撃ができるのだ。"
    },
    {
      "Id": "attack_practice",
      "Text": "を押して、攻撃してみよう。"
    },
    {
      "Id": "charge_end",
      "Text": "を押すとチャージができるのだ。"
    },
    {
      "Id": "charge_practice",
      "Text": "を押して、チャージしてみよう。"
    },
    {
      "Id": "charge_attack",
      "Text": "チャージした後に攻撃すると、強力な攻撃が出るのだ。"
    },
    {
      "Id": "charge_then",
      "Text": "でチャージして、その一拍後に、"
    },
    {
      "Id": "charge_attack_end",
      "Text": "で攻撃してみよう。"
    },
    {
      "Id": "guard_end",
      "Text": "を押すとガードができるのだ。"
    },
    {
      "Id": "guard_practice",
      "Text": "を押して、ガードしてみよう。"
    },
    {
      "Id": "special_intro",
      "Text": "エスピーがたまった後、"
    },
    {
      "Id": "special_end",
      "Text": "を押すと必殺技が発動できるのだ。"
    },
    {
      "Id": "special_practice",
      "Text": "を押して、発動してみよう。"
    },
    {
      "Id": "final",
      "Text": "お疲れさまなのだ！"
    },
    {
      "Id": "button_a",
      "Text": "エーボタン"
    },
    {
      "Id": "button_b",
      "Text": "ビーボタン"
    },
    {
      "Id": "button_x",
      "Text": "エックスボタン"
    },
    {
      "Id": "button_y",
      "Text": "ワイボタン"
    },
    {
      "Id": "button_start",
      "Text": "スタートボタン"
    },
    {
      "Id": "key_i",
      "Text": "アイキー"
    },
    {
      "Id": "key_j",
      "Text": "ジェーキー"
    },
    {
      "Id": "key_k",
      "Text": "ケーキー"
    },
    {
      "Id": "key_l",
      "Text": "エルキー"
    },
    {
      "Id": "key_u",
      "Text": "ユーキー"
    },
    {
      "Id": "walk_stick",
      "Text": "左スティックを、移動したい方向、左右に傾けて、"
    },
    {
      "Id": "walk_keyboard",
      "Text": "エーキーかディーキーで、"
    },
    {
      "Id": "direction_stick",
      "Text": "進みたい方向にスティックを倒しながら、"
    },
    {
      "Id": "direction_keyboard",
      "Text": "ダブリュー、エー、エス、ディーキーで、進みたい方向を押しながら、"
    },
    {
      "Id": "direction_hold_stick",
      "Text": "左スティックを、行きたい方向に倒したままにするのだ。"
    },
    {
      "Id": "direction_hold_keyboard",
      "Text": "ダブリュー、エー、エス、ディーキーで、行きたい方向を押し続けるのだ。"
    },
    {
      "Id": "direction_hold_command",
      "Text": "方向を変えると、技も変わるのだ！"
    },
    {
      "Id": "sp_page2",
      "Text": "コンボをつなぐほど、たまりやすいのだ！"
    },
    {
      "Id": "timer_page2",
      "Text": "0になると試合終了なのだ！"
    },
    {
      "Id": "score_award_page2",
      "Text": "これでチュートリアルは終了なのだ！"
    },
    {
      "Id": "script_102",
      "Text": "まずは画面の見方を覚えるのだ"
    },
    {
      "Id": "script_103",
      "Text": "これは体力を表すHPなのだ"
    },
    {
      "Id": "script_104",
      "Text": "攻撃を受けると減っていき、0になるとダウンなので注意しよう"
    },
    {
      "Id": "script_105",
      "Text": "次は、必殺技ゲージのSPなのだ"
    },
    {
      "Id": "script_106",
      "Text": "技を成功させるとどんどん溜まるのだ"
    },
    {
      "Id": "script_107",
      "Text": "まずは歩いてみるのだ"
    },
    {
      "Id": "script_108",
      "Text": "相手との距離を調整する基本なのだ！"
    },
    {
      "Id": "script_109",
      "Text": "次は、技を出すタイミングについて教えるのだ"
    },
    {
      "Id": "script_110",
      "Text": "技はビートに合わせると出せるのだ！"
    },
    {
      "Id": "script_111",
      "Text": "タイミングがずれると不発なのだ"
    },
    {
      "Id": "script_112",
      "Text": "タイミングを合わせる練習をしてみよう"
    },
    {
      "Id": "script_113",
      "Text": "最後に、試合のルールについて説明するのだ"
    },
    {
      "Id": "script_114",
      "Text": "この数字は、曲の残り拍数なのだ"
    },
    {
      "Id": "script_115",
      "Text": "実際に 相手を倒して 勝利してみよう！"
    },
    {
      "Id": "script_116",
      "Text": "相手を倒して、勝利した証としてカップを獲得したのだ！"
    },
    {
      "Id": "script_117",
      "Text": "ここに1つ増えたのだ"
    },
    {
      "Id": "script_118",
      "Text": "覚えた技で、対戦を楽しむのだ！"
    },
    {
      "Id": "script_119",
      "Text": "曲が終わったとき、勝利したラウンド数の多い方が勝ちなのだ！"
    },
    {
      "Id": "script_120",
      "Text": "三本先取ではないので注意しよう"
    },
    {
      "Id": "script_121",
      "Text": "次はジャンプについて教えるのだ"
    },
    {
      "Id": "script_122",
      "Text": "上に跳んで、相手の攻撃をかわせるのだ！"
    },
    {
      "Id": "script_123",
      "Text": "次は、ダッシュについて教えるのだ"
    },
    {
      "Id": "script_124",
      "Text": "歩くより早く距離を詰められるのだ！"
    },
    {
      "Id": "script_125",
      "Text": "次は、通常攻撃について教えるのだ"
    },
    {
      "Id": "script_126",
      "Text": "魔法使いの攻撃は、近くの相手を杖でたたく技なのだ！"
    },
    {
      "Id": "script_127",
      "Text": "次は、チャージについて教えるのだ"
    },
    {
      "Id": "script_128",
      "Text": "チャージをすると強力な技を打てるようになるのだ"
    },
    {
      "Id": "script_129",
      "Text": "ここからは、チャージした魔力で魔法を使うのだ！"
    },
    {
      "Id": "script_130",
      "Text": "魔法使いは、ためた回数によって発動する魔法が変わるのだ！"
    },
    {
      "Id": "script_131",
      "Text": "1回目は炎、2回目は氷、3回目以上は岩"
    },
    {
      "Id": "script_132",
      "Text": "まずは チャージ一回 炎魔法 を使ってみよう"
    },
    {
      "Id": "script_133",
      "Text": "次はチャージ２回 氷魔法 を使ってみよう"
    },
    {
      "Id": "script_134",
      "Text": "次はチャージ３回 岩魔法 を使ってみよう"
    },
    {
      "Id": "script_135",
      "Text": "次は、ガードについて教えるのだ"
    },
    {
      "Id": "script_136",
      "Text": "魔法使いは、魔法のシールドを生み出せるのだ！"
    },
    {
      "Id": "script_137",
      "Text": "シールドは攻撃を受けると消えるのだ"
    },
    {
      "Id": "script_138",
      "Text": "今度は、シールドを使った攻撃なのだ"
    },
    {
      "Id": "script_139",
      "Text": "ガードを連続ですると、シールドがどんどん溜まっていくのだ！"
    },
    {
      "Id": "script_140",
      "Text": "そして ４枚以上ためると 盾が前方に放出されるのだ"
    },
    {
      "Id": "script_141",
      "Text": "最後は、必殺技なのだ！"
    },
    {
      "Id": "script_142",
      "Text": "大きな光のビームで、相手をなぎ払う技なのだ"
    },
    {
      "Id": "script_143",
      "Text": "練習用にSPを満タンにしてあるのだ！"
    },
    {
      "Id": "script_144",
      "Text": "剣を振って、近くの相手を斬る技なのだ！"
    },
    {
      "Id": "script_145",
      "Text": "次は突進攻撃なのだ"
    },
    {
      "Id": "script_146",
      "Text": "少し離れた相手にも届いてしまう強力な技なのだ"
    },
    {
      "Id": "script_147",
      "Text": "次に、ためた力で弾丸を撃ってみよう！"
    },
    {
      "Id": "script_148",
      "Text": "離れた相手にも届く強力な弾丸が発射できるのだ！"
    },
    {
      "Id": "script_149",
      "Text": "勇者は、頭に乗ってるスライムを肉壁にして攻撃を防ぐのだ！"
    },
    {
      "Id": "script_150",
      "Text": "最後は、勇者の必殺技なのだ！"
    },
    {
      "Id": "script_151",
      "Text": "相手を斬り上げ、空中で追い打ちする技なのだ"
    },
    {
      "Id": "script_152",
      "Text": "槍を振って、近くの相手を斬る技なのだ！"
    },
    {
      "Id": "script_153",
      "Text": "次は、槍投げについて教えるのだ"
    },
    {
      "Id": "script_154",
      "Text": "戦士は、槍をまっすぐ投げて 遠くの敵を攻撃することができるのだ"
    },
    {
      "Id": "script_155",
      "Text": "次は、構えた槍を 放ってみよう"
    },
    {
      "Id": "script_156",
      "Text": "戦士は、なんと投げた先へワープすることができるのだ！"
    },
    {
      "Id": "script_157",
      "Text": "次は、空中からの下攻撃について教えるのだ"
    },
    {
      "Id": "script_158",
      "Text": "下にいる相手に 空中から一気に急降下して大ダメージを与えられるのだ"
    },
    {
      "Id": "script_159",
      "Text": "戦士は、一瞬だけ異空間にワープすることで攻撃を防げるのだ！"
    },
    {
      "Id": "script_160",
      "Text": "大量の武器を召喚し、敵めがけて武器の雨を浴びせる技なのだ"
    },
    {
      "Id": "script_161",
      "Text": "近くの相手に、重いパンチを放つ技なのだ！"
    },
    {
      "Id": "script_162",
      "Text": "次は、攻撃を防ぐガードについて教えるのだ"
    },
    {
      "Id": "script_163",
      "Text": "相手の攻撃を受け止めて、反撃の機会を作るのだ！"
    },
    {
      "Id": "script_164",
      "Text": "最後は、必殺技について教えるのだ！"
    },
    {
      "Id": "script_165",
      "Text": "魔王の必殺技は 巨大化して突進する技なのだ"
    }
  ],
