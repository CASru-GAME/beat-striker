    - Text: "\u6280\u3092\u6210\u529F\u3055\u305B\u308B\u3068\u3069\u3093\u3069\u3093\u6E9C\u307E\u308B\u306E\u3060"
      Voice: script_106
    - Text: "\u30B3\u30F3\u30DC\u3092\u3064\u306A\u3050\u307B\u3069\u3001\u305F\u307E\u308A\u3084\u3059\u3044\u306E\u3060\uFF01"
      Voice: sp_page2
  - Key: 1
    Text: {fileID: 4801581649251798641}
    Pages:
    - Text: "\u307E\u305A\u306F\u6B69\u3044\u3066\u307F\u308B\u306E\u3060"
      Voice: script_107
    - Text: "\u76F8\u624B\u3068\u306E\u8DDD\u96E2\u3092\u8ABF\u6574\u3059\u308B\u57FA\u672C\u306A\u306E\u3060\uFF01"
      Voice: script_108
  - Key: 18
    Text: {fileID: 524669402065910158}
    Pages:
    - Text: "\u6B21\u306F\u3001\u6280\u3092\u51FA\u3059\u30BF\u30A4\u30DF\u30F3\u30B0\u306B\u3064\u3044\u3066\u6559\u3048\u308B\u306E\u3060"
      Voice: script_109
    - Text: "\u6280\u306F\u30D3\u30FC\u30C8\u306B\u5408\u308F\u305B\u308B\u3068\u51FA\u305B\u308B\u306E\u3060\uFF01"
      Voice: script_110
    - Text: "\u30BF\u30A4\u30DF\u30F3\u30B0\u304C\u305A\u308C\u308B\u3068\u4E0D\u767A\u306A\u306E\u3060"
      Voice: script_111
    - Text: "\u30BF\u30A4\u30DF\u30F3\u30B0\u3092\u5408\u308F\u305B\u308B\u7DF4\u7FD2\u3092\u3057\u3066\u307F\u3088\u3046"
      Voice: script_112
  - Key: 20
    Text: {fileID: 7152049788518663434}
    Pages:
    - Text: "\u6700\u5F8C\u306B\u3001\u8A66\u5408\u306E\u30EB\u30FC\u30EB\u306B\u3064\u3044\u3066\u8AAC\u660E\u3059\u308B\u306E\u3060"
      Voice: script_113
    - Text: "\u3053\u306E\u6570\u5B57\u306F\u3001\u66F2\u306E\u6B8B\u308A\u62CD\u6570\u306A\u306E\u3060"
      Voice: script_114
    - Text: "0\u306B\u306A\u308B\u3068\u8A66\u5408\u7D42\u4E86\u306A\u306E\u3060\uFF01"
      Voice: timer_page2
  - Key: 21
    Text: {fileID: 7530275125566910337}
    Pages:
    - Text: "\u5B9F\u969B\u306B \u76F8\u624B\u3092\u5012\u3057\u3066 \u52DD\u5229\u3057\u3066\u307F\u3088\u3046\uFF01"
      Voice: script_115
  - Key: 23
    Text: {fileID: 1428309581064756485}
    Pages:
    - Text: "\u76F8\u624B\u3092\u5012\u3057\u3066\u3001\u52DD\u5229\u3057\u305F\u8A3C\u3068\u3057\u3066\u30AB\u30C3\u30D7\u3092\u7372\u5F97\u3057\u305F\u306E\u3060\uFF01"
      Voice: script_116
    - Text: "\u3053\u3053\u306B1\u3064\u5897\u3048\u305F\u306E\u3060"
      Voice: script_117
    - Text: "\u3053\u308C\u3067\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u306F\u7D42\u4E86\u306A\u306E\u3060\uFF01"
      Voice: score_award_page2
  - Key: 17
    Text: {fileID: 3768537828656744631}
    Pages:
    - Text: "\u304A\u75B2\u308C\u3055\u307E\u306A\u306E\u3060\uFF01"
      Voice: final
    - Text: "\u899A\u3048\u305F\u6280\u3067\u3001\u5BFE\u6226\u3092\u697D\u3057\u3080\u306E\u3060\uFF01"
      Voice: script_118
  - Key: 24
    Text: {fileID: 4416118383758542282}
    Pages:
    - Text: "\u65B9\u5411\u3092\u5909\u3048\u308B\u3068\u3001\u6280\u3082\u5909\u308F\u308B\u306E\u3060\uFF01"
      Voice: direction_hold_command
  - Key: 25
    Text: {fileID: 6327295233959798556}
    Pages:
    - Text: "\u66F2\u304C\u7D42\u308F\u3063\u305F\u3068\u304D\u3001\u52DD\u5229\u3057\u305F\u30E9\u30A6\u30F3\u30C9\u6570\u306E\u591A\u3044\u65B9\u304C\u52DD\u3061\u306A\u306E\u3060\uFF01"
      Voice: script_119
    - Text: "\u4E09\u672C\u5148\u53D6\u3067\u306F\u306A\u3044\u306E\u3067\u6CE8\u610F\u3057\u3088\u3046"
      Voice: script_120
