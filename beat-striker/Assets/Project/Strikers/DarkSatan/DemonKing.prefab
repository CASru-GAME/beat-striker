    IsSpecial: 0
  - Title: "\u524d\u3078\u79fb\u52d5"
    Pages:
    - Text: "\u6b21\u306f\u3001\u30c0\u30c3\u30b7\u30e5\u306b\u3064\u3044\u3066\u6559\u3048\u308b\u306e\u3060"
      Voice: script_123
    - Text: "\u6b69\u304f\u3088\u308a\u65e9\u304f\u8ddd\u96e2\u3092\u8a70\u3081\u3089\u308c\u308b\u306e\u3060\uff01"
