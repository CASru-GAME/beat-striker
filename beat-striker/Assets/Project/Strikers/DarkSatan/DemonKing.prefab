  tutorialLessons:
  - Title: "\u30b8\u30e3\u30f3\u30d7"
    Pages:
    - Text: "\u6b21\u306f\u30b8\u30e3\u30f3\u30d7\u306b\u3064\u3044\u3066\u6559\u3048\u308b\u306e\u3060"
      Voice: script_121
    - Text: "\u4e0a\u306b\u8df3\u3093\u3067\u3001\u76f8\u624b\u306e\u653b\u6483\u3092\u304b\u308f\u305b\u308b\u306e\u3060\uff01"
